#!/bin/sh /etc/rc.common
# AirPi Fan Control unified init script (procd)
# Part of luci-app-airpi-fancontrol v3.2.0

USE_PROCD=1
START=99
STOP=10

PROGRAM="airpi-fancontrol"
CONFIG_FILE="/etc/config/airpi-fan"
PID_FILE="/var/run/airpi-fancontrol.pid"

printMsg() {
    local msg="$1"
    logger -t "${PROGRAM}" "${msg}"
}

load_softpwm_driver() {
    local gpio freq module_path
    config_get gpio settings fan_gpio "540"
    config_get freq settings fan_freq "15000"
    module_path="/lib/modules/$(uname -r)/airpi-gpio-fan.ko"

    rmmod airpi_gpio_fan 2>/dev/null

    if ! insmod "$module_path" \
        fangpio="$gpio" cycle=255 period="$freq" fanen=1; then
        printMsg "failed to load soft-PWM driver"
        return 1
    fi

    printMsg "soft-PWM driver loaded (GPIO=$gpio, period=$freq us)"
}

find_pwm_path() {
    local pwm
    for pwm in /sys/class/hwmon/hwmon*/pwm1; do
        [ -w "$pwm" ] || continue
        case "$(cat "${pwm%/*}/name" 2>/dev/null)" in
            pwmfan|pwm-fan) echo "$pwm"; return 0 ;;
        esac
    done
    return 1
}

start_service() {
    local driver pwm

    [ -f "$CONFIG_FILE" ] || {
        printMsg "Config file not found, using defaults"
        driver="auto"
    }

    config_load airpi-fan
    config_get driver settings fan_driver "auto"

    pwm=$(find_pwm_path)
    if [ "$driver" = "auto" ]; then
        [ -n "$pwm" ] && driver="pwm" || driver="softpwm"
    fi

    if [ "$driver" = "softpwm" ]; then
        load_softpwm_driver || return 1
    elif [ -n "$pwm" ]; then
        rmmod airpi_gpio_fan 2>/dev/null
        printMsg "using hardware PWM driver ($pwm)"
    else
        printMsg "hardware PWM selected but pwm-fan interface was not found"
        return 1
    fi

    procd_open_instance
    procd_set_param command /usr/bin/fancts.sh
    procd_set_param respawn 3600 1 5
    procd_set_param pidfile "$PID_FILE"
    procd_close_instance

    printMsg "AirPi fan control service started (procd)"
}

stop_service() {
    # Fan cleanup: set to minimum / off
    local pwm
    for pwm in /sys/class/hwmon/hwmon*/pwm1; do
        [ -w "$pwm" ] || continue
        case "$(cat "${pwm%/*}/name" 2>/dev/null)" in
            pwmfan|pwm-fan) echo 64 > "$pwm" 2>/dev/null; break ;;
        esac
    done
    if [ -w /sys/kernel/duty_cycle ]; then
        echo 0 > /sys/kernel/duty_cycle 2>/dev/null
    fi

    printMsg "AirPi fan control service stopped"
}

service_triggers() {
    procd_add_reload_trigger "airpi-fan"
}

reload_service() {
    stop
    start
}
